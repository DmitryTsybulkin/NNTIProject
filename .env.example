# Hugging Face token - get from https://huggingface.co/settings/tokens
# Use "write" permission in case of using HuggingFace hub for storage
HF_TOKEN=your_huggingface_token_here

# Weights & Biases API key - get from https://wandb.ai/authorize
WANDB_TOKEN=your_wandb_key_here

# Docker Configuration
DOCKER_REGISTRY=docker.io
DOCKER_USER_NAME=niph00001
DOCKER_IMAGE_NAME=nnti-project
DOCKER_TAG=bias-reduction

# WandB Configuration
WANDB_PROJECT=Indic-SLID
WANDB_TEAM=nnti-team

# Resource Configuration on the cluster
REQUEST_CPU=1
REQUEST_GPU=1
REQUEST_MEMORY=16GB
RUNNING_ON_CLUSTER=true

# SSH Configuration for Submit node
SSH_USER=neuronet_team
SSH_HOST=conduit...